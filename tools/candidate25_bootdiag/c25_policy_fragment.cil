; C25 bounded boot diagnostic: only one dedicated metadata directory is writable.
(type c25_diag_data_file)
(typetransition init metadata_file dir c25_diag_data_file)
(typetransition init c25_diag_data_file file c25_diag_data_file)
(typetransition shell c25_diag_data_file file c25_diag_data_file)
(allow init metadata_file (dir (add_name search write)))
(allow init c25_diag_data_file (dir (create getattr open read search write add_name)))
(allow init c25_diag_data_file (file (create open write getattr setattr)))
(allow shell metadata_file (dir (search)))
(allow shell c25_diag_data_file (dir (getattr open read search write add_name)))
(allow shell c25_diag_data_file (file (create open read write append getattr setattr)))
(allow shell boot_status_prop (file (read getattr map open)))
(allow shell bootanim_system_prop (file (read getattr map open)))
(allow shell init_service_status_prop (file (read getattr map open)))
(allow shell system_server (binder (call transfer)))
(allow system_server shell (binder (transfer)))
(allow shell surfaceflinger (binder (call transfer)))
(allow surfaceflinger shell (binder (transfer)))
